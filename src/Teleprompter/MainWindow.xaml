<Window x:Class="Teleprompter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提词器" Width="620" Height="300" MinWidth="520" MinHeight="285"
        WindowStartupLocation="Manual" Topmost="True" ResizeMode="CanResizeWithGrip"
        Background="#F5F6FA" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E9ECF5" />
            <Setter Property="BorderBrush" Value="#D7DBE8" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ChooseFileButton" Content="选择文件" Style="{StaticResource PrimaryButton}" Click="ChooseFileButton_Click" />
                <Button x:Name="ArmButton" Content="启用" Style="{StaticResource QuietButton}" Click="ArmButton_Click" />
                <Button Content="回到开头" Style="{StaticResource QuietButton}" Click="ResetButton_Click" />
            </StackPanel>
            <Button x:Name="ExpandButton" Grid.Column="1" Content="展开 ▾" Style="{StaticResource QuietButton}" Margin="0" Click="ExpandButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StateBadge" CornerRadius="10" Background="#8A909D" Padding="9,3" VerticalAlignment="Center">
                <TextBlock x:Name="StateText" Text="未载入" Foreground="White" FontWeight="SemiBold" FontSize="12" />
            </Border>
            <TextBlock x:Name="FileText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Text="可拖入 TXT / DOCX / DOC" TextTrimming="CharacterEllipsis" Foreground="#515665" />
            <TextBlock x:Name="ProgressText" Grid.Column="2" VerticalAlignment="Center" Text="0 / 0" FontWeight="SemiBold" Foreground="#333745" />
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE1EC" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="108">
            <StackPanel>
                <TextBlock Text="下一次 Ctrl+V 将输出" Foreground="#737989" FontSize="12" />
                <TextBox x:Name="PreviewText" Margin="0,7,0,0" Text="请先选择文件" FontFamily="Microsoft YaHei UI" FontSize="17"
                         FontWeight="SemiBold" Foreground="#232735" Background="Transparent" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="118" />
            </StackPanel>
        </Border>

        <Grid x:Name="ExpandedPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="在下一条前插入" Style="{StaticResource QuietButton}" Click="InsertButton_Click" />
                <Button Content="删除所选" Style="{StaticResource QuietButton}" Click="DeleteButton_Click" />
                <Button Content="设为下一条" Style="{StaticResource QuietButton}" Click="SetNextButton_Click" />
                <TextBlock Text="双击文字可编辑；拖动行可排序" VerticalAlignment="Center" Foreground="#737989" Margin="8,0,0,0" />
            </StackPanel>
            <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="White" BorderBrush="#DDE1EC" RowHeaderWidth="0" AllowDrop="True"
                      CellEditEnding="ItemsGrid_CellEditEnding" PreviewMouseLeftButtonDown="ItemsGrid_PreviewMouseLeftButtonDown"
                      MouseMove="ItemsGrid_MouseMove" Drop="ItemsGrid_Drop">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" IsReadOnly="True" Width="48" />
                    <DataGridTextColumn Header="状态" Binding="{Binding State}" IsReadOnly="True" Width="72" />
                    <DataGridTextColumn Header="提词内容" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,9,0,0" Foreground="#6D7280" Text="暂停时系统复制粘贴不受影响" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>

