<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>提词器新版</AssemblyName>
    <RootNamespace>Teleprompter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.0</Version>
    <AssemblyTitle>提词器新版</AssemblyTitle>
    <Product>便携式全局提词器</Product>
    <Description>通过 Ctrl+V 逐行输出、Ctrl+C 回退的便携式提词工具</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocSharp.Binary.Doc" Version="0.20.0" />
    <PackageReference Include="DocSharp.Docx" Version="0.20.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Teleprompter.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
